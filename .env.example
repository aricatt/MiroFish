# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== 图谱后端选择 =====
# GRAPH_BACKEND=zep    使用 Zep Cloud（需要 ZEP_API_KEY）
# GRAPH_BACKEND=graphiti  使用本地 Graphiti + Neo4j + Ollama
GRAPH_BACKEND=zep

# ===== Zep Cloud 配置（GRAPH_BACKEND=zep 时需要）=====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Graphiti 本地化配置（GRAPH_BACKEND=graphiti 时需要）=====
# Neo4j 连接（Docker: docker run -p 7687:7687 -e NEO4J_AUTH=neo4j/password neo4j:5.26)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
# Ollama 本地 LLM（先 ollama pull qwen2.5:7b && ollama pull nomic-embed-text）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIM=768

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
